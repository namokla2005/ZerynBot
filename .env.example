# ─── Discord Bot ───────────────────────────────────────────────────────────────
# Token lấy từ: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Application ID (General Information → Application ID)
DISCORD_CLIENT_ID=

# Client Secret (OAuth2 → Client Secret)
DISCORD_CLIENT_SECRET=

# ─── Dashboard ─────────────────────────────────────────────────────────────────
# Khóa bí mật cho Flask session (đổi thành chuỗi ngẫu nhiên)
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_32chars

# URL dashboard (dùng cho OAuth2 redirect)
DASHBOARD_URL=http://localhost:5000
REDIRECT_URI=http://localhost:5000/callback

# ─── Development ───────────────────────────────────────────────────────────────
# ID server của bạn để sync slash commands ngay lập tức (không cần chờ 1 giờ)
# Để trống nếu muốn sync global
DEV_GUILD_ID=
