# ───────────────────────────────────────────────────────────────────────────────
# ZerynBot V2 — file mẫu cấu hình. Sao chép thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
# TUYỆT ĐỐI không commit `.env` (đã có trong .gitignore).
# ───────────────────────────────────────────────────────────────────────────────
# ─── Discord Bot ───────────────────────────────────────────────────────────────
# Token lấy từ: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Application ID (General Information → Application ID)
DISCORD_CLIENT_ID=

# Client Secret (OAuth2 → Client Secret)
DISCORD_CLIENT_SECRET=

# Webhook để gửi log báo lỗi bot (Tạo trong Server Settings -> Integrations -> Webhooks)
WEBHOOK_LOG_URL=https://discord.com/api/webhooks/...

# ─── Dashboard ─────────────────────────────────────────────────────────────────
# Khóa bí mật cho Flask session (đổi thành chuỗi ngẫu nhiên)
# Sinh nhanh: python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_32chars

# Mật khẩu Step-Up Auth cho các thao tác nguy hiểm trong /admin
# (Web Terminal, git pull, restart). Để trống = TẮT lớp bảo vệ này (dashboard sẽ
# hiện banner cảnh báo trên trang /admin).
# Sinh nhanh: python -c "import secrets;print(secrets.token_urlsafe(24))"
# Mật khẩu cho Step-Up Auth của /admin/system/* (Web Terminal, git-pull, restart).
# Web Terminal chạy shell thật trên máy chứa DISCORD_TOKEN + key AI, nên mật khẩu đoán
# được ~= mất quyền điều khiển máy. TỐI THIỂU 16 ký tự ngẫu nhiên; ngắn hơn hoặc để trống
# => các route đó bị vô hiệu hóa (503), không phải chạy-không-cần-xác-thực.
#   Sinh nhanh: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# URL dashboard (dùng cho OAuth2 redirect)
DASHBOARD_URL=http://localhost:5000
REDIRECT_URI=http://localhost:5000/callback

# ─── Development & Admin ───────────────────────────────────────────────────────
# ID server của bạn để sync slash commands ngay lập tức (không cần chờ 1 giờ)
# Để trống nếu muốn sync global
DEV_GUILD_ID=

# ID Discord của Chủ Bot (để có đặc quyền quản trị cấp cao và xưng hô AI là Cha/Bố)
BOT_OWNER_ID=

# Webhook gửi file sao lưu tự động (Auto Backup bot.db)
BACKUP_DB=https://discord.com/api/webhooks/...

# Webhook gửi thông báo trạng thái On/Off hệ thống
STATUS_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── AI (tuỳ chọn — có thể nhập sau trên /admin Dashboard) ────────────────────
# API key AI toàn cục: Gemini (AIzaSy...), Groq (gsk_...) hoặc OpenRouter (sk-or-...)
# Bot + Dashboard tự nhận diện provider từ prefix của key.
GEMINI_API_KEY=

# Model vision cho Groq / OpenRouter. Để trống = 2 provider này BỎ qua yêu cầu có ảnh
# và Gemini (hiện còn hỗ trợ vision) sẽ xử lý. Trước đây code hard-code
# meta-llama/llama-3.2-11b-vision-preview — dòng model đã bị Groq vô hiệu hóa
# (xem .agents/skills/ai_provider_routing/references/groq_active_models.md), mỗi lần
# gửi ảnh chỉ nhận 404 rồi vẫn thử hết provider khác. Chỉ điền model ID còn sống.
#GROQ_VISION_MODEL=
#OPENROUTER_VISION_MODEL=

# ─── Nhạc ─────────────────────────────────────────────────────────────────────
# Stream watchdog: FFmpeg giữ kết nối nhưng ngừng xuất data (mạng chập chờn, CDN treo)
# thì audio thread kẹt trong read(), `after()` không bao giờ chạy và bot phát im lặng
# vô hạn. Sau MUSIC_STALL_TIMEOUT giây không đọc được frame audio nào, bot cắt FFmpeg,
# dọn tiến trình con mồ côi và phát lại từ vị trí THỰC đã nghe được (không phải đồng hồ
# tường). Giá trị thấp hơn bị kẹp về minimum 10s/1s để một cấu hình sai không cắt nhầm
# mọi bài hát ngay khi mở stream.
#MUSIC_STALL_TIMEOUT=30
#MUSIC_STALL_CHECK_INTERVAL=5
# Tran thoi gian cho source.cleanup() (no doi tien trinh ffmpeg con). FFmpeg ket trong
# D-state tren kernel Android se khong bao gio ve; khong co tran thi co chia se giu
# _recovering=True vo han va player mat het kha nang tu khoi phuc.
#MUSIC_STALL_CLEANUP_TIMEOUT=5

# ─── Nâng cao (chỉ chỉnh khi hiểu rõ) ─────────────────────────────────────────
# Địa chỉ bind của Dashboard (mặc định 127.0.0.1 để chống truy cập trái phép qua Wi-Fi)
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=5000

# Kênh Discord nhận cảnh báo: 'Zeryn Fix Lỗi' và 'bot-log' (dùng cho /support 24/7
# khi chuyển tiếp yêu cầu lên nhân viên). Để trống = dùng giá trị mặc định trong config.py
#FIX_ERROR_CHANNEL_ID=
#BOT_LOG_CHANNEL_ID=

# Bật Flask debugger (CHỈ khi phát triển nội bộ — debugger cho phép thực thi code từ xa!)
#FLASK_DEBUG=0

# Lưu trữ cho rate limiter của dashboard: memory:// (mặc định, đủ cho 1 tiến trình)
# hoặc redis://... nếu chạy nhiều worker.
#RATELIMIT_STORAGE_URI=memory://

# Đặt 1 nếu dashboard chạy sau reverse proxy (Nginx/Cloudflare) để đọc đúng IP thật.
# KHÔNG bật khi không có proxy — kẻ tấn công có thể giả mạo IP qua header.
#BEHIND_PROXY=0
# Mặc định cookie Secure tự bật khi DASHBOARD_URL là https://. Ghi đè nếu cần:
#COOKIE_SECURE=auto

# ─── Termux Remote Management (Tùy chọn) ──────────────────────────────────────
# Cấu hình SSH để deploy hoặc điều khiển Termux từ xa qua scripts/termux_*.py
#TERMUX_HOST=192.168.1.x
#TERMUX_PORT=8022
#TERMUX_USER=u0_a...
#TERMUX_KEY_FILE=~/.ssh/id_ed25519
#TERMUX_CF_HOST=ssh.yourdomain.com
